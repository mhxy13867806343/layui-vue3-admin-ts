.layui-cascader-panel{display:flex}.layui-cascader-panel-container{display:flex;background-color:#fff}.layui-cascader-panel-selection{display:flex;align-items:center;width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-wrap:nowrap}.layui-cascader-panel-selection .layui-checkbox-label{padding:0!important}.layui-cascader-panel-selection .layui-form-radio{scale:.8;margin:0;padding:0}.layui-cascader-panel-selection .layui-form-radio i{margin-right:4px}.layui-cascader-panel-selection .layui-form-radio span{display:none}.layui-cascader-panel-list{border:1px solid #ececec;min-width:120px;max-width:200px;overflow:hidden;overflow-y:auto;scrollbar-width:none}.layui-cascader-panel-list:nth-child(n+2){border-left:none}.layui-cascader-panel-list-striped .layui-cascader-panel-item:nth-child(2n){background-color:var(--global-neutral-color-2)}.layui-cascader-panel-item{position:relative;padding:8px 36px 8px 16px;height:34px;cursor:pointer;text-overflow:ellipsis;white-space:nowrap;overflow:hidden;-webkit-user-select:none;user-select:none;display:flex;align-items:center;justify-content:space-between}.layui-cascader-panel-item-disabled{cursor:not-allowed!important;background-color:var(--global-neutral-color-4)}.layui-cascader-panel-item .layui-badge{position:absolute}.layui-cascader-panel-item:hover{background-color:var(--global-checked-color)!important;color:#fff}.layui-cascader-panel-item:hover span{color:#fff!important}.layui-cascader-panel-item:hover .layui-form-checkbox i.layui-icon{border:1px solid}.layui-cascader-panel-item:hover .layui-form-radio i.layui-icon{color:#fff}.layui-cascader-panel-item-active{background-color:var(--global-checked-color)!important;color:#fff}.layui-cascader-panel-item-active span{color:#fff!important}.layui-cascader-panel-item-active .layui-form-radio i.layui-icon{color:#fff}.layui-cascader-panel-item-active .layui-form-checkbox i.layui-icon{border:1px solid}.layui-cascader-panel-item-icon{position:absolute;right:10px}
